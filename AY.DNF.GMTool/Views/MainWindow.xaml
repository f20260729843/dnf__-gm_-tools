<Window
    x:Class="AY.DNF.GMTool.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:prism="http://prismlibrary.com/"
    Width="1280"
    Height="850"
    prism:ViewModelLocator.AutoWireViewModel="True"
    WindowStartupLocation="CenterScreen"
    Background="#F5F5F5"
    FontFamily="Microsoft YaHei UI">

    <WindowChrome.WindowChrome>
        <WindowChrome CornerRadius="15" GlassFrameThickness="-1" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- 定义渐变画刷 -->
        <LinearGradientBrush x:Key="HeaderGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#4A90E2" Offset="0"/>
            <GradientStop Color="#357ABD" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ButtonGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFFFFF" Offset="0"/>
            <GradientStop Color="#E8E8E8" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ButtonHoverGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#F0F0F0" Offset="0"/>
            <GradientStop Color="#D0D0D0" Offset="1"/>
        </LinearGradientBrush>

        <!-- 美化TextBlock样式 -->
        <Style TargetType="TextBlock">
            <Setter Property="Margin" Value="5" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="#333333" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <!-- 美化TextBox样式 -->
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="5" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Width" Value="100" />
            <Setter Property="TextAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="5,0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#CCCCCC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="12" />
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#4A90E2" />
                    <Setter Property="BorderThickness" Value="2" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 美化GroupBox样式 -->
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="5" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E0E0E0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" 
                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="3">
                                <Border.Effect>
                                    <DropShadowEffect Color="#20000000" BlurRadius="3" ShadowDepth="1" Direction="270"/>
                                </Border.Effect>
                            </Border>
                            <Border Background="{StaticResource HeaderGradient}" 
                                    CornerRadius="3,3,0,0"
                                    Height="30"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Top">
                                <TextBlock FontSize="14" 
                                           FontWeight="Bold" 
                                           Foreground="White"
                                           HorizontalAlignment="Left" 
                                           VerticalAlignment="Center"
                                           Margin="10,0,0,0"
                                           Text="{TemplateBinding Header}" />
                            </Border>
                            <ContentPresenter Margin="0,30,0,0" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 美化Button样式 -->
        <Style TargetType="Button">
            <Setter Property="Margin" Value="3" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Background" Value="{StaticResource ButtonGradient}" />
            <Setter Property="BorderBrush" Value="#CCCCCC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#333333" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center" 
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource ButtonHoverGradient}" />
                                <Setter Property="BorderBrush" Value="#4A90E2" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#D0D0D0" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#F5F5F5" />
                                <Setter Property="Foreground" Value="#999999" />
                                <Setter Property="BorderBrush" Value="#E0E0E0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 连接按钮特殊样式 -->
        <Style x:Key="ConnectButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#4CAF50" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#45A049" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#45A049" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#3E8E41" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 断开按钮特殊样式 -->
        <Style x:Key="DisconnectButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#F44336" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#DA190B" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#DA190B" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#B71C1C" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="auto" />
            <RowDefinition />
            <RowDefinition Height="25" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <Image
            Margin="20,5"
            HorizontalAlignment="Left"
            Source="/Assets/Images/Logo.png" />

        <StackPanel Grid.Row="0"
            Grid.Column="1"
            HorizontalAlignment="Left"
            VerticalAlignment="Center">
            <TextBlock
                FontSize="18"
                FontWeight="Bold"
                Foreground="#4A90E2"
                Text="{Binding Title}" />
            <TextBlock
                Margin="0,2,0,0"
                HorizontalAlignment="Center"
                FontSize="11"
                Foreground="#666666"
                Text="{Binding Version}" />
        </StackPanel>

        <Border Grid.Row="0"
            Grid.Column="1"
            Width="200"
            Margin="20,5"
            HorizontalAlignment="Right"
            Background="Transparent"
            WindowChrome.IsHitTestVisibleInChrome="True">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button
                    Click="MinClick"
                    Content="&#xe624;"
                    Style="{StaticResource ControlButtonStyle}" />
                <Button
                    Click="MaxClick"
                    Content="&#xe600;"
                    Style="{StaticResource ControlButtonStyle}" />
                <Button
                    Background="DarkRed"
                    Command="{Binding AppCloseCommand}"
                    Content="&#xe609;"
                    Style="{StaticResource ControlButtonStyle}" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="2">
            <GroupBox Header="数据库设置">
                <StackPanel VerticalAlignment="Center" Orientation="Vertical">
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                        <TextBlock Text="IP地址" />
                        <TextBox Width="150" Text="{Binding Server, Mode=TwoWay}" />
                        <TextBlock Text="用户名" />
                        <TextBox Text="{Binding UserName, Mode=TwoWay}" />
                        <TextBlock Text="密码" />
                        <TextBox
                        Name="pwd"
                        Width="100"
                        Margin="3"
                        Text="{Binding Pwd, Mode=TwoWay}" />

                        <TextBlock Text="端口" />
                        <TextBox Text="{Binding Port, Mode=TwoWay}" />
                        <Button
                        Width="80"
                        Margin="3"
                        Command="{Binding ConnectCommand}"
                        Content="连接"
                        IsEnabled="{Binding OpenEnabled}"
                        Style="{StaticResource ConnectButtonStyle}" />
                        <Button
                        Width="80"
                        Margin="3"
                        Command="{Binding DisconnectCommand}"
                        Content="断开"
                        IsEnabled="{Binding ConnectedForEnabled}"
                        Style="{StaticResource DisconnectButtonStyle}" />
                        <Button
                        Width="80"
                        Margin="3"
                        Command="{Binding ChangePwdCommand}"
                        Content="切换密码" />
                        <!--<Button
                        Width="80"
                        Margin="5"
                        Command="{Binding TestCommand}"
                        Content="测试" />-->
                        <TextBlock
                        Grid.Row="1"
                        Margin="3"
                        VerticalAlignment="Center"
                        Foreground="Red"
                        Text="切换密码：因为不同版本数据库密码可能不同，方便切换，不用记忆"
                        TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                        <TextBlock Text="数据库慢连接时长"/>
                        <TextBox Text="{Binding DbTimeout,Mode=TwoWay}"/>
                        <TextBlock Foreground="Red" Text="虚拟机性能不好，或因数据库连接超时时再修改这个值。无特殊情况不要修改。0-表示使用默认值"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="账号信息">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>

                    <DockPanel VerticalAlignment="Center">
                        <TextBlock DockPanel.Dock="Left" Text="用户名" />
                        <TextBox DockPanel.Dock="Left" Text="{Binding SearchAccount}" />
                        <Button
                            Width="80"
                            Margin="5"
                            Command="{Binding SearchAccountCommand}"
                            Content="查询"
                            DockPanel.Dock="Left"
                            IsEnabled="{Binding ConnectedForEnabled}" />

                        <Button
                            Margin="3"
                            Command="{Binding GameStartCommand}"
                            Content="启动"
                            DockPanel.Dock="Right" />
                        <Button
                            Margin="3"
                            Click="OnSelectExeClick"
                            Content="选择Exe"
                            DockPanel.Dock="Right" />
                        <TextBox
                            Width="200"
                            DockPanel.Dock="Right"
                            Text="{Binding ExeFilePath}" />
                        <TextBlock DockPanel.Dock="Right" Text="启动程序路径：" />

                    </DockPanel>

                    <StackPanel
                        Grid.Row="1"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <TextBlock Width="150">
                            <Run FontWeight="Bold" Text="UID " />
                            <Run Text="{Binding LoginInfo.Uid}" />
                        </TextBlock>
                        <TextBlock Width="150">
                            <Run FontWeight="Bold" Text="用户名 " />
                            <Run Text="{Binding LoginInfo.AccountName}" />
                        </TextBlock>
                        <TextBlock Width="150">
                            <Run FontWeight="Bold" Text="D币余额 " />
                            <Run Text="{Binding LoginInfo.DCoin}" />
                        </TextBlock>
                        <TextBlock Width="150">
                            <Run FontWeight="Bold" Text="D点余额 " />
                            <Run Text="{Binding LoginInfo.DPoint}" />
                        </TextBlock>
                        <TextBlock Width="150">
                            <Run FontWeight="Bold" Text="封停状态 " />
                            <Run Text="{Binding LoginInfo.Status}" />
                        </TextBlock>
                        <TextBlock Width="150">
                            <Run FontWeight="Bold" Text="VIP状态 " />
                            <Run Text="{Binding LoginInfo.VIP}" />
                        </TextBlock>
                        <!--<TextBlock Width="100">
        <Run Text="欣悦等级 " />
        <Run Text="{Binding LoginInfo.XinYueLevel}" />
    </TextBlock>
    <TextBlock Width="100">
        <Run Text="是否在线 " />
        <Run Text="{Binding LoginInfo.IsOnline}" />
    </TextBlock>-->
                    </StackPanel>
                </Grid>
            </GroupBox>

            <GroupBox Header="角色信息">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>

                    <UniformGrid
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Columns="5">
                        <UniformGrid.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Left" />
                                <Setter Property="Margin" Value="10,3,0,3" />
                                <Setter Property="Width" Value="200" />
                            </Style>
                        </UniformGrid.Resources>
                        <TextBlock>
                            <Run FontWeight="Bold" Text="角色编号 " />
                            <Run Text="{Binding CurMemberInfo.CharacNo}" />
                        </TextBlock>
                        <TextBlock>
                            <Run FontWeight="Bold" Text="用色名 " />
                            <Run Text="{Binding CurMemberInfo.CharacName}" />
                        </TextBlock>
                        <TextBlock>
                            <Run FontWeight="Bold" Text="等      级 " />
                            <Run Text="{Binding CurMemberInfo.Level}" />
                        </TextBlock>
                        <TextBlock>
                            <Run FontWeight="Bold" Text="职      业 " />
                            <Run Text="{Binding CurMemberInfo.Job}" />
                        </TextBlock>
                        <TextBlock Width="auto">
                            <Run FontWeight="Bold" Text="觉醒 " />
                            <Run Text="{Binding CurMemberInfo.JxNames}" />
                        </TextBlock>

                        <TextBlock>
                            <Run FontWeight="Bold" Text="副  职  业 " />
                            <Run Text="{Binding CurMemberInfo.ExpertJob}" />
                        </TextBlock>
                        <TextBlock>
                            <Run FontWeight="Bold" Text="金    币 " />
                            <Run Text="{Binding CurMemberInfo.Money}" />
                        </TextBlock>
                        <TextBlock>
                            <Run FontWeight="Bold" Text="VIP角色 " />
                            <Run Text="{Binding CurMemberInfo.VIP}" />
                        </TextBlock>
                        <TextBlock>
                            <Run FontWeight="Bold" Text="最近下线 " />
                            <Run Text="{Binding CurMemberInfo.LastPlayTime, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" />
                        </TextBlock>
                    </UniformGrid>
                </Grid>
            </GroupBox>
        </StackPanel>

        <DataGrid Grid.Column="0"
                  Name="gridMember"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  Background="White"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  HorizontalGridLinesBrush="#E0E0E0"
                  ItemsSource="{Binding MemberInfos}"
                  VerticalGridLinesBrush="#E0E0E0"
                  BorderBrush="#E0E0E0"
                  BorderThickness="1"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  AlternatingRowBackground="#F8F8F8"
                  RowBackground="White"
                  SelectionMode="Single">

            <hc:Interaction.Triggers>
                <hc:EventTrigger EventName="SelectionChanged">
                    <hc:EventToCommand Command="{Binding RowClickCommand}" CommandParameter="{Binding SelectedValue, ElementName=gridMember}" />
                </hc:EventTrigger>
            </hc:Interaction.Triggers>

            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="{StaticResource HeaderGradient}" />
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="FontWeight" Value="Bold" />
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="Padding" Value="8,5" />
                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                    <Setter Property="BorderBrush" Value="#357ABD" />
                    <Setter Property="BorderThickness" Value="0,0,1,0" />
                </Style>
            </DataGrid.ColumnHeaderStyle>

            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Background" Value="White" />
                    <Setter Property="Foreground" Value="#333333" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridRow">
                                <Border x:Name="DGR_Border" 
                                        Background="{TemplateBinding Background}" 
                                        BorderBrush="{TemplateBinding BorderBrush}" 
                                        BorderThickness="{TemplateBinding BorderThickness}" 
                                        SnapsToDevicePixels="True">
                                    <SelectiveScrollingGrid>
                                        <SelectiveScrollingGrid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </SelectiveScrollingGrid.ColumnDefinitions>
                                        <SelectiveScrollingGrid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </SelectiveScrollingGrid.RowDefinitions>
                                        <DataGridCellsPresenter Grid.Column="1" 
                                                               ItemsPanel="{TemplateBinding ItemsPanel}" 
                                                               SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                        <DataGridDetailsPresenter Grid.Column="1" Grid.Row="1" 
                                                                SelectiveScrollingGrid.SelectiveScrollingOrientation="{Binding AreRowDetailsFrozen, ConverterParameter={x:Static SelectiveScrollingOrientation.Vertical}, Converter={x:Static DataGrid.RowDetailsScrollingConverter}, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" 
                                                                Visibility="{TemplateBinding DetailsVisibility}"/>
                                        <DataGridRowHeader Grid.RowSpan="2" 
                                                          SelectiveScrollingGrid.SelectiveScrollingOrientation="Vertical" 
                                                          Visibility="{Binding HeadersVisibility, ConverterParameter={x:Static DataGridHeadersVisibility.Row}, Converter={x:Static DataGrid.HeadersVisibilityConverter}, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"/>
                                    </SelectiveScrollingGrid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="DGR_Border" Property="Background" Value="#E3F2FD" />
                                        <Setter Property="Foreground" Value="#333333" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="DGR_Border" Property="Background" Value="#2196F3" />
                                        <Setter Property="Foreground" Value="White" />
                                    </Trigger>
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="IsSelected" Value="True" />
                                            <Condition Property="IsMouseOver" Value="True" />
                                        </MultiTrigger.Conditions>
                                        <Setter TargetName="DGR_Border" Property="Background" Value="#1976D2" />
                                        <Setter Property="Foreground" Value="White" />
                                    </MultiTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </DataGrid.RowStyle>

            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Padding" Value="8,4" />
                    <Setter Property="Foreground" Value="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=Foreground}" />
                    <Setter Property="Background" Value="Transparent" />
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="Transparent" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.CellStyle>

            <DataGrid.Columns>
                <DataGridTextColumn
                    Width="50"
                    Binding="{Binding CharacNo}"
                    Header="编号"
                    IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=Foreground}" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn
                    Width="200"
                    Binding="{Binding CharacName}"
                    Header="角色名"
                    IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=Foreground}" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn
                    Width="50"
                    Binding="{Binding Level}"
                    Header="等级"
                    IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=Foreground}" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Grid
            Grid.Row="2"
            Grid.Column="1"
            Background="White">
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition />
            </Grid.RowDefinitions>
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                <StackPanel.Resources>
                    <Style TargetType="RadioButton">
                        <Setter Property="Width" Value="100" />
                        <Setter Property="Height" Value="38" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="IsEnabled" Value="{Binding ConnectedForEnabled}" />
                        <Setter Property="FontSize" Value="12" />
                        <Setter Property="FontWeight" Value="Normal" />
                        <Setter Property="Foreground" Value="#333333" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="#CCCCCC"
                                            BorderThickness="1"
                                            CornerRadius="3">
                                        <ContentPresenter HorizontalAlignment="Center" 
                                                          VerticalAlignment="Center" 
                                                          Margin="5" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter Property="Background" Value="{StaticResource HeaderGradient}" />
                                            <Setter Property="Foreground" Value="White" />
                                            <Setter Property="FontWeight" Value="Bold" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#E3F2FD" />
                                            <Setter Property="BorderBrush" Value="#4A90E2" />
                                            <Setter Property="Foreground" Value="#1976D2" />
                                        </Trigger>
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="IsChecked" Value="True" />
                                                <Condition Property="IsMouseOver" Value="True" />
                                            </MultiTrigger.Conditions>
                                            <Setter Property="Background" Value="#1976D2" />
                                            <Setter Property="Foreground" Value="White" />
                                        </MultiTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </StackPanel.Resources>

                <RadioButton
                    Command="{Binding GMToolCommand}"
                    CommandParameter="SuperTool"
                    Content="超级功能" />
                <RadioButton
                    Command="{Binding GMToolCommand}"
                    CommandParameter="Postal"
                    Content="邮件功能" />
                <RadioButton
                    Command="{Binding GMToolCommand}"
                    CommandParameter="QuestTool"
                    Content="任务管理" />
                <RadioButton
                    Command="{Binding GMToolCommand}"
                    CommandParameter="ActivityEvent"
                    Content="活动管理" />
                <RadioButton
                    Command="{Binding GMToolCommand}"
                    CommandParameter="BubbleTimer"
                    Content="泡点功能" />
                <RadioButton
                    Command="{Binding GMToolCommand}"
                    CommandParameter="Pvf"
                    Content="Script.Pvf处理" />
                <RadioButton
                    Command="{Binding GMToolCommand}"
                    CommandParameter="Online"
                    Content="角色管理" />
            </StackPanel>
            <Border
                Grid.Row="1"
                Margin="10"
                Background="White"
                BorderBrush="#E0E0E0"
                BorderThickness="1"
                CornerRadius="3">
                <Border.Effect>
                    <DropShadowEffect Color="#20000000" BlurRadius="5" ShadowDepth="2" Direction="270"/>
                </Border.Effect>
                <ContentControl
                    Margin="10"
                    prism:RegionManager.RegionName="ContentRegion" />
            </Border>
        </Grid>

        <Border Grid.Row="3"
                Grid.ColumnSpan="2"
                Background="#F8F8F8"
                BorderBrush="#E0E0E0"
                BorderThickness="0,1,0,0">
            <Grid TextBlock.FontSize="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition Width="200" />
                </Grid.ColumnDefinitions>

                <StackPanel
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                    <TextBlock
                    Margin="3"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Foreground="CadetBlue"
                    Text="{Binding LastReleaseVersion, StringFormat=最新版本号：{0}}" />

                    <Button
                    Margin="3,0,0,0"
                    BorderThickness="0"
                    Command="{Binding ShowLastVersionInfoCommand}"
                    Content="[ 查看 ]" />

                    <Button
                    Margin="3,0,0,0"
                    BorderThickness="0"
                    Command="{Binding GotoDownloadCommand}"
                    Content="[ 下载更新 ]"
                    Foreground="Blue"
                    Visibility="{Binding IsShowDownload}" />
                </StackPanel>

                <StackPanel
                Grid.Column="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                    <Border
                    Width="20"
                    Height="20"
                    Background="{Binding StateColor}"
                    CornerRadius="20">
                        <Border.Effect>
                            <DropShadowEffect
                            BlurRadius="10"
                            ShadowDepth="0"
                            Color="{Binding EffectColor}" />
                        </Border.Effect>
                    </Border>
                    <TextBlock
                    Width="100"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="{Binding StateColor}"
                    Text="{Binding PingStateStr}" />
                </StackPanel>

                <TextBlock
                    Grid.Column="2"
                    Margin="5"
                    Text="{Binding SysTime, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" />
            </Grid>
        </Border>

    </Grid>
</Window>
