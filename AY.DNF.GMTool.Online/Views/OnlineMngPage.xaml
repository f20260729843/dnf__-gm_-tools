<UserControl
    x:Class="AY.DNF.GMTool.Online.Views.OnlineMngPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:AY.DNF.GMTool.Online.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>

        <!--  查询条件  -->
        <DockPanel Margin="5" VerticalAlignment="Center">
            <TextBox
                Width="200"
                Margin="5,0,0,0"
                hc:InfoElement.Title="账号"
                hc:InfoElement.TitlePlacement="Left"
                DockPanel.Dock="Left"
                Style="{StaticResource TextBoxExtend}" />
            <TextBox
                Width="200"
                Margin="5,0,0,0"
                hc:InfoElement.Title="角色"
                hc:InfoElement.TitlePlacement="Left"
                DockPanel.Dock="Left"
                Style="{StaticResource TextBoxExtend}" />
            <CheckBox
                Margin="5,0,0,0"
                hc:InfoElement.TitlePlacement="Left"
                Content="只看在线"
                DockPanel.Dock="Left" />

            <Button
                Width="80"
                Content="查询"
                DockPanel.Dock="Right" />
        </DockPanel>

        <!--  数据结果  -->
        <DataGrid
            Grid.Row="1"
            AutoGenerateColumns="False"
            HeadersVisibility="All"
            ItemsSource="{Binding OnlineList}"
            RowHeaderWidth="60">

            <DataGrid.Columns>
                <DataGridTextColumn
                    Binding="{Binding Id}"
                    Header="Id"
                    IsReadOnly="True" />
                <DataGridTextColumn
                    Binding="{Binding Account}"
                    Header="账号"
                    IsReadOnly="True" />
                <DataGridTextColumn
                    Binding="{Binding CharacName}"
                    Header="角色"
                    IsReadOnly="True" />
                <DataGridTextColumn
                    Binding="{Binding Job}"
                    Header="职业"
                    IsReadOnly="True" />
                <DataGridTextColumn
                    Binding="{Binding Lev}"
                    Header="等级"
                    IsReadOnly="True" />
                <DataGridTextColumn
                    Binding="{Binding DeleteFlag}"
                    Header="删除标记"
                    IsReadOnly="True" />
            </DataGrid.Columns>
        </DataGrid>

        <!--  分页  -->
        <hc:Pagination Grid.Row="2" />
    </Grid>
</UserControl>
